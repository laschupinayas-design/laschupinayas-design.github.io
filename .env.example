# Copia este archivo como .env.local y pon tus datos de Supabase
# (Project Settings > API: Project URL y la clave publishable / anon).
# Nunca uses la clave service_role aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publishable

# Pago con tarjeta (Openpay). Son datos PÚBLICOS: ID del comercio y llave PÚBLICA (pk_...).
# La llave privada (sk_...) NO va aquí: se guarda en los Secrets de Supabase.
# Si los dejas vacíos, simplemente no aparece la opción de pagar con tarjeta.
VITE_OPENPAY_MERCHANT_ID=
VITE_OPENPAY_PUBLIC_KEY=
VITE_OPENPAY_SANDBOX=true
